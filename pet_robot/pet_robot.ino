// Robo eyes + orca  -  single file, just paste into Arduino IDE and upload
//
//  single tap  : change mood (default > happy > sad > angry)
//  double tap  : show the orca for 5 s, then back to the mood (touch to leave early)
//  hold ~0.8 s : go to sleep (any touch wakes)

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <FluxGarage_RoboEyes.h>

#define SDA_PIN      5
#define SCL_PIN      6
#define TOUCH_PIN    4
#define BUZZER_PIN   3         // KY-006 "S" pin
#define OLED_ADDR    0x3C      // try 0x3D if the screen stays blank

#define DOUBLE_TAP_MS 350      // max gap between two short touches for a double tap
#define HOLD_MS       800      // keep touching this long to go to sleep
#define DEBOUNCE_MS   40
#define ORCA_MS       5000     // how long the orca stays before going back to the mood
#define ORCA_Y        -1       // orca vertical position (-1 = one row higher than before)
#define EYE_THICK     2        // > < thickness: 2 = 5 px, 3 = 7 px, 1 = 3 px

Adafruit_SSD1306 display(128, 64, &Wire, -1);
RoboEyes<Adafruit_SSD1306> eyes(display);

