#define LEN(a) (sizeof(a) / sizeof(a[0]))

const Note* seq = nullptr;
uint8_t seqLen = 0, seqPos = 0;
unsigned long nextNoteAt = 0;

// ---------- Buzzer (works on ESP32 core 2.x and 3.x) ----------
void buzzerSetup() {
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcAttach(BUZZER_PIN, 2000, 8);
#else
  ledcSetup(0, 2000, 8);
  ledcAttachPin(BUZZER_PIN, 0);
#endif
}

void buzzerTone(int freq) {
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcWriteTone(BUZZER_PIN, freq);
#else
  ledcWriteTone(0, freq);
#endif
}

void playSeq(const Note* s, uint8_t len) {
  seq = s;
  seqLen = len;
  seqPos = 0;
  nextNoteAt = 0;
}

// non-blocking: one note at a time so the screen never freezes
void updateSound() {
  if (!seqLen || millis() < nextNoteAt) return;

  if (seqPos >= seqLen) {
    buzzerTone(0);
    seqLen = 0;
    return;
  }
  buzzerTone(seq[seqPos].freq);
  nextNoteAt = millis() + seq[seqPos].ms;
  seqPos++;
}

void playMoodSound(uint8_t index) {
  switch (index) {
    case 0: playSeq(defaultSnd, LEN(defaultSnd)); break;
    case 1: playSeq(happySnd,   LEN(happySnd));   break;
    case 2: playSeq(sadSnd,     LEN(sadSnd));     break;
    case 3: playSeq(angrySnd,   LEN(angrySnd));   break;
  }
}

// ---------- Eye looks ----------
void applyMood(uint8_t index) {
  // reset everything back to normal first
  eyes.setHFlicker(OFF, 0);
  eyes.setVFlicker(OFF, 0);
  eyes.setWidth(36, 36);
  eyes.setHeight(36, 36);
  eyes.setBorderradius(8, 8);
  eyes.setIdleMode(ON, 2, 2);

  eyes.setMood(moods[index]);

  if (index == 3) {                 // angry: heavy brows, shaking with rage
    eyes.setHeight(28, 28);
    eyes.setBorderradius(3, 3);
    eyes.setIdleMode(OFF, 0, 0);
    eyes.setPosition(0);
    eyes.setHFlicker(ON, 2);
  }
}

// ---------- Happy face: > < eyes ----------
// thick chevron made from several parallel lines (set EYE_THICK at the top)
void thickLine(int x0, int y0, int x1, int y1) {
  for (int t = -EYE_THICK; t <= EYE_THICK; t++) display.drawLine(x0, y0 + t, x1, y1 + t, SSD1306_WHITE);
}

unsigned long lastHappyFrame = 0;
uint8_t happyPhase = 0;

void drawHappy() {
  if (millis() - lastHappyFrame < 120) return;
  lastHappyFrame = millis();
  happyPhase++;
  int bounce = (happyPhase % 4 < 2) ? 0 : 2;      // little happy bounce

  display.clearDisplay();
  // left eye  ">"
  thickLine(22, 14 + bounce, 46, 32 + bounce);
  thickLine(46, 32 + bounce, 22, 50 + bounce);
  // right eye "<"
  thickLine(106, 14 + bounce, 82, 32 + bounce);
  thickLine(82, 32 + bounce, 106, 50 + bounce);
  display.display();
}

// ---------- Orca face (double tap) ----------
bool orcaMode = false;
unsigned long lastOrcaFrame = 0;
unsigned long orcaStart = 0;
uint8_t orcaPhase = 0;

void updateOrca() {
  if (millis() - lastOrcaFrame < 400) return;
  lastOrcaFrame = millis();
  orcaPhase++;
  int bob = (orcaPhase % 2) ? 1 : 0;              // gentle floating
  display.clearDisplay();
  display.drawBitmap(0, ORCA_Y + bob, orcaBitmap, 128, 64, SSD1306_WHITE);
  display.display();
}

// ---------- Sleep / wake ----------
bool asleep = false;

void goToSleep() {
  asleep = true;
  orcaMode = false;
  playSeq(sleepSnd, LEN(sleepSnd));
  display.clearDisplay();
  display.display();
  display.ssd1306_command(SSD1306_DISPLAYOFF);
}

void wakeUp() {
  asleep = false;
  display.ssd1306_command(SSD1306_DISPLAYON);
  moodIndex = 0;
  applyMood(moodIndex);
  playSeq(wakeSnd, LEN(wakeSnd));
}

// ---------- Touch ----------
bool lastTouch = false;
unsigned long lastEdge = 0;
unsigned long pressStart = 0;
bool held = false;                 // this press already became a hold (sleep)
bool pendingTap = false;           // waiting to see if a 2nd tap follows
unsigned long pendingTapTime = 0;

void setup() {
  pinMode(TOUCH_PIN, INPUT);
  buzzerSetup();
  buzzerTone(0);

  Wire.begin(SDA_PIN, SCL_PIN);
  display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR);

  eyes.begin(128, 64, 100);
  eyes.setAutoblinker(ON, 3, 2);
  applyMood(moodIndex);

  playSeq(startupSnd, LEN(startupSnd));
}

void loop() {
  bool touch = digitalRead(TOUCH_PIN);
  unsigned long now = millis();

  // finger just touched
  if (touch && !lastTouch && now - lastEdge > DEBOUNCE_MS) {
    lastEdge = now;
    pressStart = now;
    held = false;
  }

  // finger kept on the sensor: go to sleep
  if (touch && lastTouch && !held && !asleep && now - pressStart >= HOLD_MS) {
    held = true;
    pendingTap = false;
    goToSleep();
  }

  // finger lifted
  if (!touch && lastTouch && now - lastEdge > DEBOUNCE_MS) {
    lastEdge = now;

    if (held) {
      // that press was a hold, nothing more to do
    } else if (asleep) {
      wakeUp();                                    // any touch wakes him
      pendingTap = false;
    } else if (orcaMode) {
      orcaMode = false;                            // touch leaves the orca
      pendingTap = false;
      applyMood(moodIndex);
    } else if (pendingTap && now - pendingTapTime <= DOUBLE_TAP_MS) {
      pendingTap = false;                          // second tap = orca
      orcaMode = true;
      orcaPhase = 0;
      lastOrcaFrame = 0;
      orcaStart = now;
      playSeq(orcaSnd, LEN(orcaSnd));
    } else {
      pendingTap = true;                           // maybe the first of two
      pendingTapTime = now;
    }
  }
  lastTouch = touch;

  // no second tap arrived: it was a single tap, change the mood
  if (pendingTap && !touch && now - pendingTapTime > DOUBLE_TAP_MS) {
    pendingTap = false;
    moodIndex = (moodIndex + 1) % moodCount;
    applyMood(moodIndex);
    playMoodSound(moodIndex);
  }

  // orca has been on screen long enough: back to the mood
  if (orcaMode && now - orcaStart >= ORCA_MS) {
    orcaMode = false;
    applyMood(moodIndex);
  }

  updateSound();
  if (asleep) return;
  if (orcaMode) updateOrca();
  else if (moodIndex == 1) drawHappy();
  else eyes.update();
}